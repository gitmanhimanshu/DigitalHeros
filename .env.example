# Database (Prisma SQLite for instant local dev & zero friction; Supabase Postgres supported for cloud)
# Database (Prisma SQLite for local dev; Supabase PostgreSQL for cloud production)
DATABASE_URL="file:./dev.db"

# Supabase Deployment
# Supabase Production Deployment
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Authentication JWT Secret
JWT_SECRET=super-secret-digital-heroes-jwt-key-change-in-production

# Stripe Payments (Test Mode)
STRIPE_SECRET_KEY=sk_test_placeholder_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret

# Platform Host URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

